# Copy to ignored deployment/waha.env. Generate independent long random secrets.
# Choose a reviewed immutable image tag/digest from the provider releases.
WAHA_IMAGE=
WAHA_ENGINE=NOWEB
WAHA_NAMESPACE=modern
WAHA_SESSION_NAMESPACE=modern
# Provision a dedicated role and databases; do not reuse the office login.
# Generated privately by: node scripts/setup-waha-storage.mjs
WHATSAPP_SESSIONS_POSTGRESQL_URL=
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_WEBHOOK_URL=https://your-application.example/api/webhooks/waha

# Put the following in the Next.js server environment (not NEXT_PUBLIC_*):
WAHA_URL=http://127.0.0.1:3001
WAHA_SESSION=default
CRON_SECRET=
