# Supabase-hosted PostgreSQL: server secret, never NEXT_PUBLIC.
SUPABASE_DB_URL=postgresql://postgres.PROJECT:PASSWORD@YOUR-POOLER:5432/postgres
# Set to the public HTTPS origin on a deployed installation (no trailing slash).
APP_ORIGIN=
# The bundled certs/supabase-ca.crt is used by default. Override with PEM text
# when the deployment database has a different verified certificate authority.
# SUPABASE_DB_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Existing optional Supabase browser helpers; the platform itself uses the
# private Postgres schema and server sessions, not Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional until WAHA is provisioned and paired. Never expose these in NEXT_PUBLIC.
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=
CRON_SECRET=

# Background worker target (internal URL in Docker Compose).
NOTIFICATION_WORKER_URL=http://127.0.0.1:3000/api/cron/notifications
